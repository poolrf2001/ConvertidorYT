# Copy to .env and edit before `docker compose up`.

# Domain that points to this droplet (A record).
SERVER_NAME=tudominio.com

# Allowed web origins for CORS. In production = https://SERVER_NAME.
ALLOWED_ORIGINS=https://tudominio.com

# Email for Let's Encrypt renewal notifications.
CERTBOT_EMAIL=tu-email@ejemplo.com

# Retention window for finished jobs (seconds).
JOB_RETENTION_SECONDS=86400
CLEANUP_INTERVAL_SECONDS=3600

# Per-request limits.
MAX_DURATION_SECONDS=1200
MAX_PLAYLIST_ITEMS=20
